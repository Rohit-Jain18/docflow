# Placeholder variable names only. Never put actual secrets in this file.
DOCFLOW_ENV=development
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL intentionally unset locally: Django-default SQLite.
# Production must configure PostgreSQL through secret storage.
WA_PLATFORM_BASE_URL=https://wa.kizieemedia.com
WA_PLATFORM_API_VERSION=v25.0
# WA_PLATFORM_DEVELOPER_TOKEN=<backend-only-secret-not-set-here>
WHATSAPP_TEMPLATE_NAME=lab_report_ready
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_PATIENT_FACING_FILENAME=Diagnostic_Report.pdf
TEMP_UPLOAD_MODE=disabled
TEMP_UPLOAD_FICTIONAL_DATA_ONLY=false
TEMP_UPLOAD_EXPECTED_HOST=tmpfiles.org
TEMP_UPLOAD_TTL_SECONDS=3600
TEMP_UPLOAD_EXPIRY_BUFFER_SECONDS=300
AGENT_CLEANUP_RETENTION_HOURS=24
AGENT_FAILED_RETENTION_DAYS=14
# Development-only account verification override (strictly disabled in production)
DEV_ACCOUNT_VERIFICATION_OVERRIDE=false
# DEV_TEST_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
# DEV_TEST_ACCOUNT_ID=00000000-0000-0000-0000-000000000002
# Never use tmpfiles.org with real patient data.

